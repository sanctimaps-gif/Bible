# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé (par défaut : claude-opus-5)
BIBLE_MODELE=claude-opus-5

# Effort de raisonnement : low | medium | high | xhigh | max
BIBLE_EFFORT=high

# Répertoire de données (corpus AELF, cache HTTP, index de recherche)
BIBLE_DONNEES=./data

# Durée de vie du cache HTTP, en secondes (défaut : 7 jours)
BIBLE_CACHE_TTL=604800

# Zone liturgique AELF : romain | france | afrique | belgique | luxembourg | suisse | canada
BIBLE_ZONE=romain

# Délai entre deux requêtes AELF lors de l'ingestion, en secondes (politesse)
BIBLE_DELAI_INGESTION=0.5
